{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chatobby.local/schemas/actions-storage-policy.schema.json",
  "title": "Chatobby connector Actions storage policy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "owner",
    "repository",
    "sourceAuthority",
    "cleanupMaxItems",
    "cleanupMaxBytes",
    "transientArtifactDays",
    "retainedArtifacts",
    "retainedCaches"
  ],
  "properties": {
    "$schema": {
      "const": "./actions-storage-policy.schema.json"
    },
    "schemaVersion": {
      "const": 2
    },
    "owner": {
      "type": "string",
      "minLength": 1
    },
    "repository": {
      "const": "TitanicEclair/chatobby"
    },
    "sourceAuthority": {
      "const": "TitanicEclair/pi-mono:config/chatobby.operations.json#retention.actionsStorage"
    },
    "cleanupMaxItems": {
      "const": 50
    },
    "cleanupMaxBytes": {
      "const": 10737418240
    },
    "transientArtifactDays": {
      "const": 1
    },
    "retainedArtifacts": {
      "const": 0
    },
    "retainedCaches": {
      "const": 0
    }
  }
}
