{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chatobby.local/schemas/actions-storage-policy.schema.json",
  "title": "Chatobby connector Actions storage policy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "owner",
    "repository",
    "sourceAuthority",
    "artifactDays",
    "cacheMaximumAgeDays",
    "cleanupMaxItems",
    "cleanupMaxBytes"
  ],
  "properties": {
    "$schema": {
      "const": "./actions-storage-policy.schema.json"
    },
    "schemaVersion": {
      "const": 1
    },
    "owner": {
      "type": "string",
      "minLength": 1
    },
    "repository": {
      "const": "TitanicEclair/chatobby"
    },
    "sourceAuthority": {
      "const": "TitanicEclair/pi-mono:config/chatobby.operations.json#retention.actionsStorage"
    },
    "artifactDays": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidateTransfer",
        "candidateResume",
        "portableEvidence",
        "operationalEvidence"
      ],
      "properties": {
        "candidateTransfer": {
          "const": 1
        },
        "candidateResume": {
          "const": 7
        },
        "portableEvidence": {
          "const": 14
        },
        "operationalEvidence": {
          "const": 30
        }
      }
    },
    "cacheMaximumAgeDays": {
      "const": 30
    },
    "cleanupMaxItems": {
      "const": 50
    },
    "cleanupMaxBytes": {
      "const": 10737418240
    }
  }
}
